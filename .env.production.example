# Copy to .env.production and fill in. NEVER commit the filled-in file (.env* is git-ignored).
# Generate secrets with:  openssl rand -base64 48

# --- database (use a managed Postgres in production and point DB_URL at it) ---
DB_PASSWORD=
# DB_URL=jdbc:postgresql://your-db-host:5432/ridehail?sslmode=require
# DB_USER=ridehail

# --- application secrets ---
JWT_SECRET=                 # 32+ random bytes. Changing it signs everyone out.
ADMIN_PASSWORD=             # the bootstrap admin account; create named admins in the panel, then disable it
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# --- web origins and URLs ---
ALLOWED_ORIGINS=https://rider.example.com,https://customer.example.com,https://admin.example.com
PUBLIC_REALTIME_URL=wss://api.example.com/ws

# --- Stripe (live keys; see docs/STRIPE_TEST_MODE_SETUP.md section 6) ---
STRIPE_API_KEY=             # sk_live_... or a restricted rk_live_...
STRIPE_PUBLISHABLE_KEY=     # pk_live_...
STRIPE_WEBHOOK_SECRET=      # whsec_A,whsec_B  (account endpoint, then Connect endpoint)
RIDEHAIL_STRIPE_CONNECT_COUNTRY=US
STRIPE_ONBOARDING_RETURN_URL=ridehail://payouts/done
STRIPE_ONBOARDING_REFRESH_URL=ridehail://payouts/retry
STRIPE_CARD_RETURN_URL=https://customer.example.com/account
STRIPE_CARD_CANCEL_URL=https://customer.example.com/account

# --- phone notifications (see docs/DEPLOYMENT.md) ---
# PUSH_PROVIDER=expo          # "none" sends nothing; expo is the default in production
# EXPO_ACCESS_TOKEN=          # only with enhanced push security in your Expo project

# --- optional ---
# MANAGEMENT_PORT is fixed at 9090 inside the compose network. APP_PORT, ADMIN_PORT, RIDER_WEB_PORT, CUSTOMER_WEB_PORT and
# PROMETHEUS_PORT change the loopback ports the TLS terminator proxies to.
