# Where the Spring Boot API lives, as seen from the admin server (never exposed to the browser).
BACKEND_URL=http://localhost:8080
# Map tiles. The default is OpenStreetMap's public server, which is fine for development only:
# its usage policy forbids heavy use. Use your own tile provider in production, e.g. https://tiles.example.com/{z}/{x}/{y}.png
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Map starting point (lat,lon,zoom) when nothing is on the road yet.
MAP_DEFAULT_VIEW=12.9716,77.5946,12
# Set to "true" only if the panel is served over plain http (local docker); production must keep cookies Secure.
ALLOW_INSECURE_COOKIES=false
