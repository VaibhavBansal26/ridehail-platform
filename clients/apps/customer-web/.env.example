# Where the Spring API is, as seen from this app's server. Never reaches the browser.
BACKEND_URL=http://localhost:8080
# The WebSocket the browser connects to for offers and trip updates (needs this app's origin in the API's ALLOWED_ORIGINS).
# Blank = the same host as BACKEND_URL with ws:// or wss://.
# REALTIME_URL=ws://localhost:8080/ws
# Plain-http local development only: without it cookies are Secure and the browser drops them on http.
ALLOW_INSECURE_COOKIES=true
# Development only: forward the "use a test card" shortcut (the simulated payment provider accepts a token from the client;
# a real one refuses it). Leave unset anywhere real.
# DEV_CARD_SHORTCUT=true
# NEXT_PUBLIC_DEV_CARD=true
# Map tiles for the ride maps. The default is OpenStreetMap's public server, which is fine for development only:
# its usage policy forbids heavy use. Use your own tile provider in production, e.g. https://tiles.example.com/{z}/{x}/{y}.png
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
